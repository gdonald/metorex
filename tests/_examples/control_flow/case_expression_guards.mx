# Case expression with pattern matching (Metorex extension - guards not in standard Ruby)

# Simple value matching  
value = 5
result = case value
when 1 then "one"
when 5 then "five"
else "other"
end
puts result

# Array destructuring
numbers = [3, 7]
output = case numbers
when [3, 7] then "three and seven"
when [1, 2] then "one and two"
else "other"
end
puts output

# Type matching
num = 15
category = case num
when Integer then "it's an integer"
when String then "it's a string"
else "other type"
end
puts category

# Pattern matching with binding
point = [5, 5]
quadrant = case point
when [5, 5] then "exact match"
when [_, _] then "two element array"
else "other"
end
puts quadrant
